{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schema_version", "skill_name", "evaluation_policy", "evals"],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "skill_name": {"type": "string", "const": "xuanyituwen"},
    "evaluation_policy": {
      "type": "object",
      "required": ["trigger_evaluation", "online_image_generation_in_ci"],
      "properties": {
        "trigger_evaluation": {"type": "boolean", "const": false},
        "online_image_generation_in_ci": {"type": "boolean", "const": false}
      }
    },
    "evals": {
      "type": "array",
      "minItems": 5,
      "items": {
        "type": "object",
        "required": ["id", "case_version", "name", "stage", "prompt", "fixture_paths", "allowed_actions", "forbidden_actions", "machine_assertions", "judge_rubric", "pass_threshold", "baseline_prompt", "trials", "model_environment"],
        "properties": {
          "id": {"type": "string"},
          "case_version": {"type": "integer", "minimum": 1},
          "name": {"type": "string"},
          "stage": {"type": "string"},
          "prompt": {"type": "string"},
          "fixture_paths": {"type": "array", "items": {"type": "string"}},
          "allowed_actions": {"type": "array", "items": {"type": "string"}},
          "forbidden_actions": {"type": "array", "items": {"type": "string"}},
          "machine_assertions": {"type": "array", "minItems": 1},
          "judge_rubric": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "pass_threshold": {"type": "number", "minimum": 0, "maximum": 1},
          "baseline_prompt": {"type": "string"},
          "trials": {"type": "integer", "minimum": 1},
          "model_environment": {"type": "object"}
        }
      }
    }
  }
}
